# Platform identity for this plugin node — the three values Infra mints when the
# plugin is defined in a space. Per-mailbox tokens NEVER live here; they travel
# with each call as a settings profile (see the plugin set-up form).
PLUGIN_ID=aa-bbb-ccc-dddd
INFRA_CRED=LS0tLS1CRUdJTiBOQVRTIFVTRVIgSldULS0t...   # base64 of the .creds blob
INFRA_URL=localhost:4222

# Built-in shared Google OAuth client (recommended). Set these to ONE Desktop-type
# OAuth client from FloMorphic's Google Cloud project and every user signs in
# against it with PKCE — no per-user client, no credentials JSON to paste. For a
# Desktop client Google treats the secret as non-confidential, so shipping it here
# is the documented pattern. Leave unset to require a per-profile credentials JSON.
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# GOOGLE_OAUTH_REDIRECT=http://localhost
