{
  "name": "@flomorphic/gmail-plugin",
  "version": "0.1.0",
  "description": "Inflowenger plugin node for Gmail — send, search, read and label messages over the Gmail REST API, built on @inflowenger/node-plugin-sdk.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@inflowenger/node-plugin-sdk": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
